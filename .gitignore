# ── PlatformIO build output ──────────────────────────────────────────────────
.pio/

# ── Native host test build output (tests/host/) ──────────────────────────────
tests/host/build/
tests/host/out/

# ── WiFi credentials — NEVER commit ─────────────────────────────────────────
src/wifi_creds.h

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ── ESP-IDF generated files (auto-regenerated on build) ─────────────────────
sdkconfig
sdkconfig.xiao_esp32s3
sdkconfig.seeed_xiao_esp32s3

# ── IDF Component Manager (fetched at build time, not part of source) ────────
managed_components/
dependencies.lock

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# ── Gateway log data and trained models (generated at runtime, not source) ───
mic_tools/logs/
mic_tools/model/


# ── Backup and temp files ─────────────────────────────────────────────────────
*.bak
*.orig
*.swp
*.tmp

# ── AI-tool session artifacts (not part of source) ────
.claude/
build_log_stackfix.txt

# ── Misc local dev artifacts (not part of source) ────────────────────────────
sdkconfig.mic_char_*
partitions_8mb.csv
find_xiao_port.ps1
*.code-workspace
heap_soak_log*.txt
imu_soak_log.txt
serial_log2.txt
__scratch_test__*

# ── Phase-prompt scratch docs (Phase 0 / 0.5 are tracked and handled
#    separately — see docs/PHASE_0_PROMPT.md, docs/PHASE_0.5_CONNECTIVITY_PROMPT.md)
docs/PHASE_*_PROMPT.md
!docs/PHASE_0_PROMPT.md
!docs/PHASE_0.5_CONNECTIVITY_PROMPT.md

# ── Internal comparison/outreach notes — never commit ────────────────────────
docs/RAHUL_COMPARISON_AUDIT.md
docs/AUDIT_VERIFICATION_REPORT.md
docs/PRE_RAHUL_HANDOFF_PROMPT.md
docs/RAHUL_OUTREACH_DRAFT.md
