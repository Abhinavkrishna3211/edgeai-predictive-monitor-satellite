# ── PlatformIO build output ──────────────────────────────────────────────────
.pio/

# ── Native host test build output (tests/host/) ──────────────────────────────
tests/host/build/
tests/host/out/

# ── WiFi credentials — NEVER commit ─────────────────────────────────────────
src/wifi_creds.h

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ── ESP-IDF generated files (auto-regenerated on build) ─────────────────────
sdkconfig
sdkconfig.xiao_esp32s3
sdkconfig.seeed_xiao_esp32s3

# ── IDF Component Manager (fetched at build time, not part of source) ────────
managed_components/
dependencies.lock

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# ── Gateway log data and trained models (generated at runtime, not source) ───
mic_tools/logs/
mic_tools/model/


# ── Backup and temp files ─────────────────────────────────────────────────────
*.bak
*.orig
*.swp
*.tmp

# ── AI-tool session artifacts (not part of source) ────
.claude/
build_log_stackfix.txt

# ── Misc local dev artifacts (not part of source) ────────────────────────────
sdkconfig.mic_char_*
partitions_8mb.csv
find_xiao_port.ps1
*.code-workspace
heap_soak_log*.txt
imu_soak_log.txt
serial_log2.txt
__scratch_test__*

# ── Phase-prompt scratch docs (local-only working references) ────────────────
docs/PHASE_*_PROMPT.md

# ── Internal comparison/outreach notes — never commit ────────────────────────
docs/COMPARISON_AUDIT_LOCAL.md
docs/AUDIT_VERIFICATION_REPORT.md
docs/PRE_HANDOFF_PROMPT_LOCAL.md
docs/OUTREACH_DRAFT_LOCAL.md

# ── Ad-hoc scratch prompts (working notes, not part of source) ───────────────
docs/*_PROMPT.md

# ── Runtime/test-run output, not source ───────────────────────────────────────
mic_tools/char_logs/
tests/host/Testing/

# ── Internal AI-planning docs — local-only working references, not pushed ────
AGENTS.md
docs/MASTER_PLAN.md
