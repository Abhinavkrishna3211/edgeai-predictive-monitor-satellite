# Copy this file to .env.local (gitignored) to set a dev-bench-local
# default MQTT broker host/port without a source edit or a manual
# PLATFORMIO_BUILD_FLAGS export every time the bench network changes.
# Read by pio.sh / pio.ps1 (thin wrappers around `pio`), the same
# .env.local pattern tools/devrig/ uses for REF_REPO_URL.
#
# This only seeds the *compiled* first-boot default
# (components/epm_drivers/link_mqtt.c / src/threads/wifi_task.c's
# #ifndef-guarded EPM_MQTT_BROKER_HOST/PORT, falls back to "10.42.0.1":1883
# if this file is absent or a value is unset). Any host/port submitted
# through the satellite's captive provisioning portal always wins once
# saved to NVS -- see README.md's "Provision WiFi + MQTT broker" section.
EPM_MQTT_BROKER_HOST=192.168.1.5
EPM_MQTT_BROKER_PORT=1883
